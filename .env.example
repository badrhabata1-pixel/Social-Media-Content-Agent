# Copy this file to .env and fill in the values. Never commit .env.

# Module 4 - Image Generation (Gemini "Nano Banana")
# Create a key at https://aistudio.google.com/apikey
# Without a key, /generate-image still works and returns the image prompt + designer brief.
GEMINI_API_KEY=

# Optional: pin one image model. By default the newest available Nano Banana model is used
# (gemini-nano-banana-2.1, then gemini-3.1-flash-image, then gemini-2.5-flash-image).
# IMAGE_MODEL=gemini-nano-banana-2.1

# Module 5 - Facebook Page publishing (Meta Graph API)
# A Page access token with pages_manage_posts (publishing) and pages_read_engagement (metrics).
# Get it from the Graph API Explorer or Meta Business settings. Tokens expire: regenerate when
# /publish/facebook reports "invalid or expired token".
FACEBOOK_PAGE_ID=your_page_id
FACEBOOK_PAGE_ACCESS_TOKEN=your_page_access_token
