# Copy this file to .env and fill in the values. Never commit .env.

# Module 4 - Image Generation (Gemini "Nano Banana")
# Create a key at https://aistudio.google.com/apikey
# Without a key, /generate-image still works and returns the image prompt + designer brief.
GEMINI_API_KEY=

# Optional: pin one image model. By default the newest available Nano Banana model is used
# (gemini-nano-banana-2.1, then gemini-3.1-flash-image, then gemini-2.5-flash-image).
# IMAGE_MODEL=gemini-nano-banana-2.1
